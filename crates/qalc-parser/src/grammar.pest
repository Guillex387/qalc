// Keywords and comments

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

BLOCK_COMMENT = _{ "/*" ~ (BLOCK_COMMENT | (!"*/" ~ ANY))* ~ "*/" }
LINE_COMMENT = _{ ("//" | "#") ~ (!"\n" ~ ANY)* ~ ("\n" | EOI) }
COMMENT = _{ LINE_COMMENT | BLOCK_COMMENT }

keyword = _{ "if" | "else" | "null" | "let" | "type" | "alias" | "in" | "then" | "match" | "default" | "perform" | "linear" | "where" }

// Identifiers

simple_identifier = @{ !(keyword ~ !ASCII_ALPHANUMERIC) ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Literals

dec_integer = { ASCII_DIGIT+ }
hex_integer = { "0x" ~ ASCII_HEX_DIGIT+ }
bin_integer = { "0b" ~ ("0" | "1")+ }

unknow_integer = @{ hex_integer | bin_integer | dec_integer }

u8_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "u8" }
u16_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "u16" }
u32_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "u32" }
u64_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "u64" }
i8_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "i8" }
i16_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "i16" }
i32_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "i32" }
i64_integer = @{ (hex_integer | bin_integer | dec_integer) ~ "i64" }

literal = _{ u8_integer | u16_integer | u32_integer | u64_integer | i8_integer | i16_integer | i32_integer | i64_integer | unknow_integer }

// Operators

apply_operator = { "$" }
pipe_operator = { "|>" }

logic_or_operator = { "||" }
logic_and_operator = { "&&" }

or_operator = { "|" }
and_operator = { "&" }
xor_operator = { "^" }

equal_operator = { "==" }
not_equal_operator = { "!=" }
less_equal_operator = { "<=" }
greater_equal_operator = { ">=" }
less_operator = { "<" }
greater_operator = { ">" }

add_operator = { "+" }
subtract_operator = { "-" }

multiply_operator = { "*" }
divide_operator = { "/" }
module_operator = { "%" }

raised_operator = { "**" }

overloadable_operators = _{ logic_or_operator | logic_and_operator | equal_operator | not_equal_operator | less_equal_operator | greater_equal_operator | less_operator | greater_operator | add_operator | subtract_operator | raised_operator | multiply_operator | divide_operator | module_operator | or_operator | and_operator | xor_operator }

binary_operators = _{ pipe_operator | apply_operator | logic_or_operator | logic_and_operator | equal_operator | not_equal_operator | less_equal_operator | greater_equal_operator | less_operator | greater_operator | add_operator | subtract_operator | raised_operator | multiply_operator | divide_operator | module_operator | or_operator | and_operator | xor_operator }

// Atom expressions

operator_identifier = { "`" ~ overloadable_operators ~ "`" }
identifier = _{ simple_identifier | operator_identifier }

partial_operation_left = { "(" ~ binary_operators ~ expression_atom ~ ")" }
partial_operation_right = { "(" ~ expression_atom ~ binary_operators ~ ")" }
call_expression = { (identifier | "(" ~ expression ~ ")") ~ (lambda_expression | partial_operation_right | partial_operation_left | "(" ~ expression ~ ")" | identifier | literal)+ }
lambda_expression = { "(" ~ identifier* ~ ")" ~ "=>" ~ expression }

// Block expressions

assigment_expression = { simple_identifier ~ "=" ~ expression }

let_block = { "let" ~ assigment_expression ~ ("," ~ assigment_expression)* ~ "in" ~ expression }
if_else_block = { "if" ~ expression ~ "then" ~ expression ~ "else" ~ expression }
match_block = { "match" ~ expression ~ "{" ~ (expression ~ "->" ~ expression) ~ ("," ~ expression ~ "->" ~ expression)* ~ ("," ~ "default" ~ "->" ~ expression)? ~ "}" }
perform_block = { "perform" ~ "{" ~ (assigment_expression | expression) ~ ("," ~ (assigment_expression | expression))* ~ "}" }
linear_block = { "linear" ~ "{" ~ (assigment_expression | expression) ~ ("," ~ (assigment_expression | expression))* ~ "}" }

block_expression = _{ let_block | if_else_block | match_block | perform_block | linear_block }

// Binary expressions

expression_atom = _{ block_expression | lambda_expression | partial_operation_right | partial_operation_left | call_expression | "(" ~ expression ~ ")" | identifier | literal }
expression = { expression_atom ~ (binary_operators ~ expression_atom)* }

// Type

type_inner = { "(" ~ type ~ ")" }
type_slice = { "["~ type ~"]" }
type_tuple = { "(" ~ type ~ ("," ~ type)+ ~ ")" | "(" ~ ")" }
type_atom = _{ simple_identifier | type_slice | type_tuple | type_inner }

type = { type_atom ~ ("->" ~ type_atom)* }

// Declarations

type_function_annotation = { identifier ~ "::" ~ type }

type_restriction = { "linear" }

type_declaration = { "type" ~ simple_identifier ~ "{" ~ type_function_annotation+ ~ "}" ~ ("where" ~ type_restriction ~ ("," ~ type_restriction)*)?  }
function_declaration = { type_function_annotation ~ identifier ~ simple_identifier* ~ "=" ~ expression }

declarations = _{ type_declaration | function_declaration }

// Entry grammar production

program = { SOI ~ declarations* ~ EOI }